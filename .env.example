# APP_URL: The URL where this platform is hosted.
APP_URL=

# ML_SERVICE_URL: Python FastAPI Machine Learning & Security Analysis Service URL (server-side proxy only)
ML_SERVICE_URL=http://localhost:8000

# AUTH_SECRET: Optional secret key for signing defense clearance session tokens.
# If omitted, an ephemeral cryptographically strong key is generated at server boot.
AUTH_SECRET=

# NODE_ENV: Runtime environment (production or development)
NODE_ENV=production

