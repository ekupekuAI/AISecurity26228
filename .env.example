# AI Integrity Assurance Platform -- configuration
#
# Copy to .env and edit. Every value here has a safe default; the ones that matter for a
# production deployment are marked REQUIRED IN PRODUCTION.
#
# Generate a secret with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------

# production | development. Production refuses to start if the configuration is unsafe.
NODE_ENV=development

# Loopback by default. Set to 0.0.0.0 only for a deliberate intranet deployment, and set
# APP_URL to match so CORS and cookie policy line up.
HOST=127.0.0.1
PORT=3000

# The origin the console is served from. Required when HOST is not loopback.
APP_URL=

# ---------------------------------------------------------------------------
# Secrets  (REQUIRED IN PRODUCTION)
# ---------------------------------------------------------------------------

# Signs session tokens. At least 32 characters. If unset, a persistent secret is
# generated under data/keys/session.secret -- acceptable for a single node, but set it
# explicitly before running more than one instance or sessions will not be portable.
AUTH_SECRET=

# Shared secret for the gateway -> engine hop. Only needed when they run on different
# hosts; on a single node the engine's loopback binding is the control that matters.
AIA_SERVICE_TOKEN=

# First-boot administrator. If omitted, an account is created with a generated password
# printed once to the console and flagged must-change-password.
AIA_BOOTSTRAP_USER=
AIA_BOOTSTRAP_PASSWORD=

# ---------------------------------------------------------------------------
# Assurance engine
# ---------------------------------------------------------------------------

# Must be loopback or a private range. A public address is refused at boot: this endpoint
# receives every uploaded dataset and checkpoint, so an unconstrained value is a data
# exfiltration channel.
ML_SERVICE_URL=http://127.0.0.1:8000

# Extra hostnames allowed for the engine, comma-separated. Only for an intentional
# intranet split where DNS names are used instead of addresses.
AIA_ENGINE_ALLOWED_HOSTS=

# Milliseconds. A full model assessment with trigger inversion can take several minutes.
AIA_ENGINE_TIMEOUT_MS=900000

# ---------------------------------------------------------------------------
# Sessions and limits
# ---------------------------------------------------------------------------

AIA_SESSION_TTL=28800        # absolute session lifetime, seconds
AIA_SESSION_IDLE=2700        # idle timeout, seconds
AIA_MAX_UPLOAD_BYTES=2147483648
AIA_MAX_JSON_BYTES=2097152

# Number of reverse proxies in front of this server. 0 means X-Forwarded-For is ignored
# entirely, which is correct when there is no proxy -- otherwise any caller can spoof it
# and bypass per-address rate limiting.
AIA_TRUST_PROXY_HOPS=0

# ---------------------------------------------------------------------------
# Demo mode
# ---------------------------------------------------------------------------

# Enables the evaluation-seeding endpoints and the read-only demo login. Refused in
# production: those endpoints exist to make a demonstration convenient, not to be
# reachable on a deployed node.
AIA_DEMO_MODE=true

# ---------------------------------------------------------------------------
# Python assurance engine  (read by ml-engine/core/config.py)
# ---------------------------------------------------------------------------

AIA_ENV=development
AIA_ML_HOST=127.0.0.1
AIA_ML_PORT=8000

# Addresses permitted to reach the engine. Loopback only by default.
AIA_TRUSTED_CLIENTS=127.0.0.1,::1

# Require the shared service token on every engine request.
AIA_REQUIRE_SERVICE_TOKEN=false

# CPU threads for torch. Raise on a dedicated analysis node.
AIA_TORCH_THREADS=4

# Allows the engine to load a checkpoint and run behavioural batteries and trigger
# inversion. Set to false for a structural-only posture; the loader never deserialises a
# checkpoint that failed the opcode audit either way.
AIA_ALLOW_MODEL_EXECUTION=true

# Seconds budgeted for Neural Cleanse trigger inversion across all classes.
AIA_NEURAL_CLEANSE_TIMEOUT=600

# Path to the staged reference backbone. Produced by:
#   python ml-engine/scripts/provision_backbone.py
# Without it, embedding analytics fall back to a deterministic random-initialised network
# and every affected finding is reported at reduced confidence with an explicit
# limitation -- degraded, but never silently so.
AIA_BACKBONE_WEIGHTS=

# Permits downloading backbone weights at runtime. MUST remain false on an air-gapped
# node; it exists only for development convenience.
AIA_ALLOW_WEIGHT_DOWNLOAD=false

# Identifier printed on assurance reports and audit blocks.
AIA_NODE_ID=AIR-GAPPED ASSURANCE NODE
