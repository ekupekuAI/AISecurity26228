# Copy to ../.env (repo root) and fill in. Never commit the real .env.
#
#   cp deploy/.env.example .env    # from the repo root, then edit

# --- required ---------------------------------------------------------------
# 48+ random bytes. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# First-boot administrator account. If unset, a one-time password is printed to the
# container logs on first start (docker compose logs).
AIA_BOOTSTRAP_USER=admin
AIA_BOOTSTRAP_PASSWORD=

# --- public (shared-testing) deployment only --------------------------------
# The domain you point at this VM's IP. Caddy issues HTTPS for it automatically.
PUBLIC_DOMAIN=assurance.example.com
APP_URL=https://assurance.example.com

# --- optional ---------------------------------------------------------------
AIA_NODE_ID=SHARED-TEST NODE
AIA_TORCH_THREADS=4
# Leave demo mode off for real accounts; set true only to expose the read-only observer.
AIA_DEMO_MODE=false
