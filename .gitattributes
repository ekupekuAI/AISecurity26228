# Normalise text to LF in the repo; check out native on Windows.
* text=auto eol=lf

# Scripts and Dockerfiles MUST stay LF or they break on Linux / in the container.
*.sh   text eol=lf
*.service text eol=lf
Dockerfile text eol=lf
entrypoint.sh text eol=lf

# Binary assets: never touch.
*.png  binary
*.jpg  binary
*.woff2 binary
*.zip  binary
*.pt   binary
*.pth  binary
*.ico  binary
