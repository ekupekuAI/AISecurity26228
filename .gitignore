node_modules/
build/
dist/
coverage/
.DS_Store
*.log
.env*
!.env.example

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
vendor/

# Database & SQLite files (WAL/SHM included: they hold uncommitted pages)
data/*.db
data/*.db-wal
data/*.db-shm
data/*.sqlite
data/*.sqlite-journal
data/*.sqlite-wal
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite-journal
*.sqlite-wal

# Runtime working directories (never source; recreated on boot)
data/uploads/
data/work/
data/keys/

# Cryptographic keys and certificates -- must never be committed
*.pem
*.key
*.cert
*.crt

# Local model-training scratch
*.ckpt
scratch/

# Large model binaries -- regenerated by scripts (provision_backbone.py, train_models.py).
# Kept out of git: 44-46 MB each, and never source. A fresh clone stages them locally.
*.pth
*.pt
